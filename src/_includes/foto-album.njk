---
layout: base.njk
---
<a class="zurueck" href="/fotos/">&larr; Zurück zu allen Fotos</a>
<h1>{{ titel }}</h1>
{% if datum %}<p class="karte-datum">{{ datum | datumDeutsch }}</p>{% endif %}

{{ content | safe }}

{% if fotos and fotos.length %}
<div class="galerie">
  {% for foto in fotos %}
  <a href="{{ foto.bild }}" target="_blank" rel="noopener">
    <img src="{{ foto.bild }}" alt="{{ foto.text or titel }}" loading="lazy" />
  </a>
  {% endfor %}
</div>
{% else %}
<p>Für dieses Album wurden noch keine Fotos hinterlegt.</p>
{% endif %}
